# Everything that must not go out with the repo.
#
# private/ holds the journal submission files, the CDS registration guide, the
# venue strategy, the review correspondence and the session handover. None of it
# belongs in a public data release, and some of it would be actively unhelpful
# to a referee.
private/

# Quarto and LaTeX build litter
paper/*.html
paper/*_files/
paper/*.tex
paper/*.aux
paper/*.log
paper/*.out
paper/.quarto/
_site/

# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/

# Scratch
*.partial
*.tmp
.DS_Store

# Large intermediates that are regenerated, never edited. The catalogue itself
# IS tracked: it is the result, and it is checksummed.
*.npz
*.npy
!catalogue/*.npy

# The raw v1.5 tables are over GitHub's 100 MB file limit. They sit here for the
# Zenodo upload; GitHub gets catalogue/DEBBIE_v1.5.csv.gz, which decompresses to
# the CSV in catalogue/SHA256SUMS.
catalogue/DEBBIE_v1.5.csv
catalogue/DEBBIE_v1.5.ecsv
*.part

# LaTeX litter from rebuilding the Research Note
rnaas/*.aux
rnaas/*.fdb_latexmk
rnaas/*.fls
rnaas/*.log
rnaas/*.out

# Output of tools/debbie_images.py
debbie_images/
